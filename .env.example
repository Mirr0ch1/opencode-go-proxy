# Copy to opencode.env and fill in real values. Never commit opencode.env.

# Your OpenCode Go subscription key (https://opencode.ai/go console).
# Never shared with clients — the proxy holds it exclusively.
OPENCODE_GO_API_KEY=sk-REPLACE_ME

# The token clients present as `Authorization: Bearer <PROXY_TOKEN>`.
# Required — the proxy refuses to start without it.
PROXY_TOKEN=REPLACE_ME
